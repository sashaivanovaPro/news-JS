{
    "trailingComma": "es5",
    "tabWidth": 4,
    "semi": true,
    "singleQuote": true,
    "printWidth": 120,
    "overrides": [
        {
            "files": ["*.html", "*.css"],
            "options": {
                "tabWidth": 2,
                "singleQuote": false
            }
        }
    ]
}
